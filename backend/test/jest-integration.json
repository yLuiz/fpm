{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/integration/.*[.]int-spec[.]ts$",
  "transform": { "^.+[.](t|j)s$": "ts-jest" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "testTimeout": 30000
}
