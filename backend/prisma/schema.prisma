generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EquipmentType {
  MOTOR
  COMPRESSOR
  PUMP
  CONVEYOR
  PANEL
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
}

enum EquipmentStatus {
  ACTIVE
  INACTIVE
}

enum MaintenanceKind {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  SCHEDULED
  DONE
}

enum DowntimeCause {
  MECHANICAL
  ELECTRICAL
  OPERATIONAL
  OTHER
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  role         UserRole  @default(USER)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Equipment {
  id          String          @id @default(uuid())
  name        String
  type        EquipmentType
  location    String
  criticality Criticality
  status      EquipmentStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  maintenances Maintenance[]
  downtimes    Downtime[]

  @@index([type])
  @@index([status])
  @@index([criticality])
  @@index([deletedAt])
  @@index([type, status])
  @@map("equipments")
}

model Maintenance {
  id           String            @id @default(uuid())
  equipmentId  String
  dueDate      DateTime
  concludedAt  DateTime?
  status       MaintenanceStatus @default(SCHEDULED)
  kind         MaintenanceKind   @default(PREVENTIVE)
  /// Preventiva que originou esta corretiva (itens "Não OK" no checklist)
  originId     String?
  /// O que precisa ser corrigido (corretivas)
  description  String?
  checklist    Json?
  observations String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  origin      Maintenance?  @relation("MaintenanceOrigin", fields: [originId], references: [id])
  correctives Maintenance[] @relation("MaintenanceOrigin")
  downtime    Downtime?     @relation("DowntimeCorrective")

  @@index([equipmentId])
  @@index([kind, status])
  @@index([originId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([equipmentId, status])
  @@index([deletedAt])
  @@map("maintenances")
}

/// Parada não planejada de um equipamento (falha real)
model Downtime {
  id                String        @id @default(uuid())
  equipmentId       String
  startedAt         DateTime
  /// Nulo enquanto o equipamento está parado
  endedAt           DateTime?
  cause             DowntimeCause
  description       String
  /// Snapshot: o equipamento tinha preventiva vencida quando parou
  preventiveOverdue Boolean       @default(false)
  /// Corretiva aberta junto com a parada (opcional)
  correctiveId      String?       @unique
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  equipment  Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  corrective Maintenance? @relation("DowntimeCorrective", fields: [correctiveId], references: [id])

  @@index([equipmentId])
  @@index([startedAt])
  @@index([endedAt])
  @@index([deletedAt])
  @@map("downtimes")
}

model FrequencySettings {
  id            String        @id @default(uuid())
  equipmentType EquipmentType @unique
  frequencyDays Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("frequency_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([entity, action])
  @@map("audit_logs")
}
